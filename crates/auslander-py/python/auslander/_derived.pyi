class EquivalenceDiscoveryLimits(_CoreValue):
    def __init__(
        self,
        max_vertices: int = ...,
        max_directed_mutations: int = ...,
        max_total_terms: int = ...,
        max_matrix_entries: int = ...,
        max_hom_spaces: int = ...,
        through_silting: bool = ...,
    ) -> None: ...
    @property
    def max_vertices(self) -> int: ...
    @property
    def max_directed_mutations(self) -> int: ...
    @property
    def max_total_terms(self) -> int: ...
    @property
    def max_matrix_entries(self) -> int: ...
    @property
    def max_hom_spaces(self) -> int: ...
    @property
    def through_silting(self) -> bool: ...


class IncompleteEquivalenceGraph(_CoreValue):
    @property
    def vertex_count(self) -> int: ...
    @property
    def keys(self) -> list[str]: ...
    @property
    def edges(self) -> list[tuple[int, int, str, int]]: ...
    @property
    def blocked(self) -> list[tuple[int, str, int, str]]: ...
    @property
    def stop(self) -> str: ...
    @property
    def completed_mutations(self) -> int: ...
