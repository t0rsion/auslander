class DerivedInvariants(_CoreValue):
    @property
    def algebra(self) -> Algebra: ...
    @property
    def limits(self) -> InvariantLimits: ...
    @property
    def readings(self) -> list[InvariantReading]: ...
    def reading(self, kind: str) -> InvariantReading: ...
    def first_difference(self, other: DerivedInvariants) -> str | None: ...
    def __getitem__(self, kind: str) -> InvariantReading: ...
    def __len__(self) -> int: ...
    def _repr_html_(self) -> str: ...


class DerivedInequivalenceWitness(_CoreValue):
