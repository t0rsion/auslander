        kind: str | None = ...,
    ) -> None: ...
    @property
    def left(self) -> Algebra: ...
    @property
    def right(self) -> Algebra: ...
    @property
    def kind(self) -> str: ...
    @property
    def left_value(self) -> Any: ...
    @property
    def right_value(self) -> Any: ...
    @property
    def limits(self) -> InvariantLimits: ...
    def verify(self) -> bool: ...


